# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# .env is gitignored — never commit real values. The ones below are safe
# dev-only placeholders, used by BOTH ways of running this project:
#   - the manual workflow (.venv + manage.py runserver + npm run dev)
#   - docker compose up --build
#
# docker-compose.yml overrides POSTGRES_HOST and DJANGO_DEBUG itself for the
# containerized backend, so the same file works for both without contradiction.

# --- Django ---
DJANGO_SECRET_KEY=dev-only-change-me-not-a-real-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Comma-separated list of origins allowed to make cross-origin requests to
# this API (django-cors-headers). The manual/Docker workflows serve the
# frontend from the same origin the Vite dev server proxies through, but set
# this so a frontend running on its own origin (Vite's 5173) can still call
# the API directly. In production (e.g. separate Render services for
# frontend and API), set this to the deployed frontend's exact origin, e.g.
# https://tenora-frontend.onrender.com — never a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Postgres ---
# POSTGRES_HOST=localhost is for the manual workflow, connecting to a
# Postgres you installed yourself. Docker Compose overrides this to "db"
# (the compose service name) for the containerized backend.
POSTGRES_DB=billing_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Google Sign-In (optional) ---
# Web-application OAuth Client ID from the Google Cloud console. Every Google
# ID token's audience is checked against this. Leave blank to disable Google
# sign-in (verification's audience check simply never matches). See
# docs/google-signin-spec.md §0.
GOOGLE_OAUTH_CLIENT_ID=

# --- Production email delivery (optional) ---
# Provider-neutral: Django's own SMTP backend, so any SMTP-compatible
# transactional provider (SendGrid, Postmark, SES-SMTP, Mailgun, ...) works
# by changing these values only — never a code change. Leave EMAIL_BACKEND
# unset to keep the console backend (prints to the terminal/log — the
# correct default for local dev and the automated test suite, which must
# never need real SMTP credentials or network access to run).
#   EMAIL_BACKEND       — e.g. django.core.mail.backends.smtp.EmailBackend
#                          to send for real; unset/console backend otherwise.
#   EMAIL_HOST          — your provider's SMTP hostname.
#   EMAIL_PORT          — usually 587 (STARTTLS) or 465 (implicit TLS/SSL).
#   EMAIL_HOST_USER     — SMTP username (often an API key for the provider).
#   EMAIL_HOST_PASSWORD — SMTP password/API secret. NEVER commit a real
#                          value — this file only documents the variable
#                          name, and it is never logged by the application.
#   EMAIL_USE_TLS       — "true" for STARTTLS (port 587 typically).
#   EMAIL_USE_SSL       — "true" for implicit TLS/SSL (port 465 typically).
#                          Mutually exclusive with EMAIL_USE_TLS — setting
#                          both to "true" fails the deployment at startup.
#   DEFAULT_FROM_EMAIL  — the From address on outgoing mail; must usually be
#                          a verified sender/domain with your provider.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
DEFAULT_FROM_EMAIL=

# --- Brevo transactional email API (optional; recommended for Render Free) ---
# Render's Free plan blocks outbound SMTP on ports 25/465/587, so the SMTP
# settings above cannot deliver mail from a Free-plan deployment no matter
# which provider they point at. Brevo's HTTPS transactional email API is a
# separate delivery path that doesn't use SMTP or those settings at all —
# set EMAIL_PROVIDER=brevo to use it instead of the console/SMTP path above.
# Leave EMAIL_PROVIDER unset to keep the console/SMTP behavior (the correct
# default for local dev and the automated test suite — Brevo credentials are
# never required to run this project locally).
#   EMAIL_PROVIDER   — "brevo" to send via Brevo's API; unset/anything else
#                       keeps the console/SMTP path above.
#   BREVO_API_KEY    — your Brevo account's API key (Settings -> SMTP & API
#                       -> API Keys). NEVER commit a real value — this file
#                       only documents the variable name, and it is never
#                       logged by the application. Required, and the
#                       deployment refuses to start without it, whenever
#                       EMAIL_PROVIDER=brevo.
#   DEFAULT_FROM_NAME — the display name on outgoing mail (DEFAULT_FROM_EMAIL
#                        above is still the From address for Brevo too, and
#                        must be a verified sender in your Brevo account).
EMAIL_PROVIDER=
BREVO_API_KEY=
DEFAULT_FROM_NAME=

# --- Celery / background jobs (Stage D7) ---
# Message broker for the webhook retry sweep and periodic usage snapshots.
# Manual workflow: a Redis you run locally (new prerequisite, like Postgres).
# docker-compose.yml overrides this to redis://redis:6379/0 for its containers.
# The automated test suite runs tasks in-process and never touches the broker.
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Payment gateway ---
# Which adapter apps.billing uses. "razorpay" (real SDK, needs the keys below)
# or "mock" (no network, no credentials — fine for local dev and tests).
PAYMENT_GATEWAY=razorpay

# --- Razorpay (Stage D onward; only used when PAYMENT_GATEWAY=razorpay) ---
# Test-mode credentials from the Razorpay dashboard (Settings -> API Keys).
# NEVER put live keys here. Leave blank until you start Stage D — plan sync
# and webhook verification fail closed without them. See docs/stage-d1-spec.md
# §0 for where each value comes from (the webhook secret is set when you add
# the webhook under Settings -> Webhooks).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Superuser bootstrap (temporary; hosts with no shell/SSH access only) ---
# docker-entrypoint.sh runs apps/users/management/commands/
# bootstrap_superuser.py on every container start, after migrations. It is a
# no-op unless BOTH variables below are set, and even then only creates a
# user if no row with that email already exists — it never overwrites an
# existing user's password. Useful for platforms like Render's Free plan
# that give no shell to run `manage.py createsuperuser` interactively.
# NEVER put real credentials here — this documents the variable names only;
# set actual values directly in the host's environment/secrets, not in a
# committed file. Unset both (or remove them from the host) once the
# superuser exists — see the deployment notes for why it's safe to leave
# wired in either way.
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

# --- Docker Compose only ---
# Seed a throwaway demo user/tenant/plan/subscription on container start, so
# a fresh `docker compose up --build` has something to log in and look at
# immediately. Never affects the manual workflow. See apps/tenants/management/
# commands/seed_demo_data.py.
SEED_DEMO_DATA=true

# Host ports exposed by docker-compose.yml. Defaults avoid colliding with the
# manual workflow's own ports (Postgres 5432, manage.py runserver 8000, Vite
# 5173) so both workflows can run side by side. Override any of these if they
# collide with something else on your machine.
DB_HOST_PORT=5433
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=8080
