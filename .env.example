# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# .env is gitignored — never commit real values. The ones below are safe
# dev-only placeholders, used by BOTH ways of running this project:
#   - the manual workflow (.venv + manage.py runserver + npm run dev)
#   - docker compose up --build
#
# docker-compose.yml overrides POSTGRES_HOST and DJANGO_DEBUG itself for the
# containerized backend, so the same file works for both without contradiction.

# --- Django ---
DJANGO_SECRET_KEY=dev-only-change-me-not-a-real-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Comma-separated list of origins allowed to make cross-origin requests to
# this API (django-cors-headers). The manual/Docker workflows serve the
# frontend from the same origin the Vite dev server proxies through, but set
# this so a frontend running on its own origin (Vite's 5173) can still call
# the API directly. In production (e.g. separate Render services for
# frontend and API), set this to the deployed frontend's exact origin, e.g.
# https://tenora-frontend.onrender.com — never a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Postgres ---
# POSTGRES_HOST=localhost is for the manual workflow, connecting to a
# Postgres you installed yourself. Docker Compose overrides this to "db"
# (the compose service name) for the containerized backend.
POSTGRES_DB=billing_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Google Sign-In (optional) ---
# Web-application OAuth Client ID from the Google Cloud console. Every Google
# ID token's audience is checked against this. Leave blank to disable Google
# sign-in (verification's audience check simply never matches). See
# docs/google-signin-spec.md §0.
GOOGLE_OAUTH_CLIENT_ID=

# --- Celery / background jobs (Stage D7) ---
# Message broker for the webhook retry sweep and periodic usage snapshots.
# Manual workflow: a Redis you run locally (new prerequisite, like Postgres).
# docker-compose.yml overrides this to redis://redis:6379/0 for its containers.
# The automated test suite runs tasks in-process and never touches the broker.
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Payment gateway ---
# Which adapter apps.billing uses. "razorpay" (real SDK, needs the keys below)
# or "mock" (no network, no credentials — fine for local dev and tests).
PAYMENT_GATEWAY=razorpay

# --- Razorpay (Stage D onward; only used when PAYMENT_GATEWAY=razorpay) ---
# Test-mode credentials from the Razorpay dashboard (Settings -> API Keys).
# NEVER put live keys here. Leave blank until you start Stage D — plan sync
# and webhook verification fail closed without them. See docs/stage-d1-spec.md
# §0 for where each value comes from (the webhook secret is set when you add
# the webhook under Settings -> Webhooks).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Docker Compose only ---
# Seed a throwaway demo user/tenant/plan/subscription on container start, so
# a fresh `docker compose up --build` has something to log in and look at
# immediately. Never affects the manual workflow. See apps/tenants/management/
# commands/seed_demo_data.py.
SEED_DEMO_DATA=true

# Host ports exposed by docker-compose.yml. Defaults avoid colliding with the
# manual workflow's own ports (Postgres 5432, manage.py runserver 8000, Vite
# 5173) so both workflows can run side by side. Override any of these if they
# collide with something else on your machine.
DB_HOST_PORT=5433
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=8080
