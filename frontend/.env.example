# Copy to .env.local for local overrides. All keys must be VITE_-prefixed to be
# exposed to the client bundle.

# Base URL every API request is prefixed with. Default (unset) is "/api", which
# the Vite dev server proxies to Django. Set an absolute origin only for a
# deployment where the API is not same-origin.
# VITE_API_BASE_URL=/api

# Where the dev-server proxy forwards /api/* (default http://localhost:8000).
# VITE_API_PROXY_TARGET=http://localhost:8000

# google-signin-spec.md — the same Google Cloud OAuth 2.0 Web-application
# Client ID the backend's GOOGLE_OAUTH_CLIENT_ID reads (root .env). Required
# for the "Sign in with Google" button to initialize; with it unset the
# button silently does nothing rather than erroring the whole page.
# VITE_GOOGLE_OAUTH_CLIENT_ID=
